---
import Layout from '../../layouts/Layout.astro';
import { items } from '../../data/items';
import { allGroups } from '../../data/travelGroups';

export async function getStaticPaths() {
  // Allow slugs from both the original items and travel groups
  const itemSlugs = items.map((it) => ({ params: { slug: it.slug } }));
  const groupSlugs = allGroups.map((g) => ({ params: { slug: g.slug } }));
  // Deduplicate by slug
  const seen = new Set<string>();
  const merged = [...itemSlugs, ...groupSlugs].filter((e) => {
    const s = e.params.slug;
    if (seen.has(s)) return false;
    seen.add(s);
    return true;
  });
  return merged;
}

const { slug } = Astro.params;
let item = items.find((it) => it.slug === slug);

if (!item) {
  const g = allGroups.find((gr) => gr.slug === slug);
  if (g) {
    item = {
      id: g.id,
      slug: g.slug,
      title: g.title,
      description: `${g.destination} · ${g.shortDescription}`,
      imageUrl: g.coverUrl
    };
  }
}

if (!item) {
  return Astro.redirect('/');
}
---

<Layout>
	<main style="max-width: 960px; margin: 0 auto; padding: 24px 16px;">
		<a href="/" style="text-decoration: none; color: #2563eb;">← Back</a>
		<h1 style="margin: 12px 0 8px;">{item.title}</h1>
		<p style="margin: 0 0 16px; color: #4b5563;">{item.description}</p>
		<div style="border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; background: #fff;">
			<img src={item.imageUrl} alt={item.title} style="width: 100%; height: auto; display: block;" />
		</div>
	</main>
</Layout>


