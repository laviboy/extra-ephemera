---
import Layout from "../../layouts/Layout.astro";
import { allGroups } from "../../data/travelGroups";
import { ImageGallery } from "../../components/ui/image-gallery";
import { ReserveSpotButton } from "../../components/travel/ReserveSpotButton";
import { TravelCompanions } from "../../components/travel/TravelCompanions";
import { SpotsAlert } from "../../components/travel/SpotsAlert";

export async function getStaticPaths() {
  return allGroups.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
let group = allGroups.find((g) => g.slug === slug || g.id === slug);
let isDbListing = false;
let listingImages: Array<{ id: string; url: string; caption?: string }> = [];
let creator: { id: string; name: string | null; email: string; role: string } | null = null;
let creatorId: string | null = null;

// If not found in static groups, try fetching from API (for database listings)
if (!group) {
  try {
    const response = await fetch(`${Astro.url.origin}/api/listings`);
    if (response.ok) {
      const { listings } = await response.json();
      const dbListing = listings.find((l: any) => l.id === slug);
      if (dbListing) {
        isDbListing = true;
        creator = dbListing.creator || null;
        creatorId = dbListing.creator_id || dbListing.creator?.id || null;
        
        // Transform database listing into group format with all fields
        group = {
          id: dbListing.id,
          slug: dbListing.id,
          title: dbListing.title,
          destination: dbListing.destination || "Malaysia",
          coverUrl: dbListing.first_image_url || `https://picsum.photos/seed/${encodeURIComponent(dbListing.id)}/800/600`,
          description: dbListing.description || "Discover this amazing place",
          shortDescription: dbListing.short_description || dbListing.description?.slice(0, 150) || "Discover this amazing place",
          startDate: dbListing.start_date || new Date().toISOString(),
          endDate: dbListing.end_date || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),
          priceUsd: dbListing.price_min || 99,
          currency: dbListing.currency || "USD",
          maxGroupSize: dbListing.max_group_size || 12,
          availableSpots: dbListing.available_spots || 8,
          seatsLeft: dbListing.available_spots || 8,
          ageRangeMin: dbListing.age_range_min || 18,
          ageRangeMax: dbListing.age_range_max || 65,
          difficulty: dbListing.difficulty || "moderate" as const,
          tags: dbListing.tags || ["adventure", "cultural"],
          rating: dbListing.rating || 0,
          reviewCount: dbListing.review_count || 0,
          includedItems: dbListing.included_items || [],
          notIncludedItems: dbListing.not_included_items || [],
          itinerary: dbListing.itinerary || [],
          cancellationPolicy: dbListing.cancellation_policy || "Free cancellation up to 30 days before departure.",
          companions: dbListing.companions || [],
        } as any;

        // Fetch images for this listing
        try {
          const imagesResponse = await fetch(
            `${Astro.url.origin}/api/images?listingId=${slug}`
          );
          if (imagesResponse.ok) {
            const { images } = await imagesResponse.json();
            listingImages = images || [];
          }
        } catch (imgError) {
          console.error("Error fetching images:", imgError);
        }
      }
    }
  } catch (error) {
    console.error("Error fetching listing:", error);
  }
}

if (!group) {
  return Astro.redirect("/");
}

// Calculate duration
const startDate = new Date(group.startDate);
const endDate = new Date(group.endDate);
const duration = Math.ceil(
  (endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24)
);

// Populate galleryImages with real images only
const galleryImages = isDbListing && listingImages.length > 0
  ? listingImages.map((img) => img.url)
  : [
      group.coverUrl,
      `https://picsum.photos/seed/${group.slug}-2/800/600`,
      `https://picsum.photos/seed/${group.slug}-3/800/600`,
      `https://picsum.photos/seed/${group.slug}-4/800/600`,
      `https://picsum.photos/seed/${group.slug}-5/800/600`,
    ];

// Get similar trips (exclude current)
const similarTrips = allGroups.filter((g) => g.id !== group.id).slice(0, 3);
---

<Layout>
  <!-- Breadcrumb -->
  <div class="bg-white border-b sticky top-[73px] z-40">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-rose-600 transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to all trips
      </a>
    </div>
  </div>

  <!-- Hero Gallery -->
  <div class="bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 py-6">
      <div class="grid grid-cols-4 gap-2 h-[500px]">
        {galleryImages.length === 1 && (
          <!-- Single image: Full width -->
          <div class="col-span-4 rounded-2xl overflow-hidden cursor-pointer" onclick="window.openGallery(0)">
            <img
              src={galleryImages[0]}
              alt={group.title}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
        )}

        {galleryImages.length === 2 && (
          <!-- 2 images: Side by side -->
          <>
            <div class="col-span-4 md:col-span-2 row-span-2 rounded-2xl overflow-hidden cursor-pointer" onclick="window.openGallery(0)">
              <img
                src={galleryImages[0]}
                alt={group.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-4 md:col-span-2 row-span-2 rounded-2xl overflow-hidden cursor-pointer" onclick="window.openGallery(1)">
              <img
                src={galleryImages[1]}
                alt={`${group.title} 2`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
          </>
        )}

        {galleryImages.length === 3 && (
          <!-- 3 images: Main + 2 stacked -->
          <>
            <div class="col-span-4 md:col-span-2 row-span-2 rounded-2xl overflow-hidden cursor-pointer" onclick="window.openGallery(0)">
              <img
                src={galleryImages[0]}
                alt={group.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-2 md:col-span-1 rounded-xl overflow-hidden cursor-pointer" onclick="window.openGallery(1)">
              <img
                src={galleryImages[1]}
                alt={`${group.title} 2`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-2 md:col-span-1 rounded-xl overflow-hidden cursor-pointer" onclick="window.openGallery(2)">
              <img
                src={galleryImages[2]}
                alt={`${group.title} 3`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-2 md:col-span-1 hidden md:block"></div>
          </>
        )}

        {galleryImages.length === 4 && (
          <!-- 4 images: Main + 3 side -->
          <>
            <div class="col-span-4 md:col-span-2 row-span-2 rounded-2xl overflow-hidden cursor-pointer" onclick="window.openGallery(0)">
              <img
                src={galleryImages[0]}
                alt={group.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-2 md:col-span-1 rounded-xl overflow-hidden cursor-pointer" onclick="window.openGallery(1)">
              <img
                src={galleryImages[1]}
                alt={`${group.title} 2`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-2 md:col-span-1 rounded-xl overflow-hidden cursor-pointer" onclick="window.openGallery(2)">
              <img
                src={galleryImages[2]}
                alt={`${group.title} 3`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-2 md:col-span-1 rounded-xl overflow-hidden cursor-pointer" onclick="window.openGallery(3)">
              <img
                src={galleryImages[3]}
                alt={`${group.title} 4`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="col-span-2 md:col-span-1 hidden md:block"></div>
          </>
        )}

        {galleryImages.length >= 5 && (
          <!-- 5+ images: Main + 4 side images -->
          <>
            <div class="col-span-4 md:col-span-2 row-span-2 rounded-2xl overflow-hidden cursor-pointer" onclick="window.openGallery(0)">
              <img
                src={galleryImages[0]}
                alt={group.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            {galleryImages.slice(1, 5).map((img, i) => (
              <div class={`col-span-2 md:col-span-1 rounded-xl overflow-hidden ${i === 3 ? 'relative' : ''} cursor-pointer`} onclick={`window.openGallery(${i + 1})`}>
                <img
                  src={img}
                  alt={`${group.title} ${i + 2}`}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                />
                {i === 3 && galleryImages.length > 5 && (
                  <div class="absolute inset-0 bg-black/60 flex items-center justify-center hover:bg-black/70 transition-all">
                    <span class="text-white text-xl font-semibold">
                      +{galleryImages.length - 5} more
                    </span>
                  </div>
                )}
              </div>
            ))}
          </>
        )}
      </div>
    </div>
  </div>

  <!-- React Gallery Component - Hidden lightbox that opens on click -->
  <div id="gallery-modal" style="position: fixed; top: -9999px; left: -9999px; visibility: hidden;">
    <ImageGallery 
      images={isDbListing && listingImages.length > 0 
        ? listingImages 
        : galleryImages.map((url, i) => ({ id: `img-${i}`, url, caption: `${group.title} ${i + 1}` }))
      } 
      client:only="react" 
    />
  </div>

  <script is:inline>
    // Global function to open gallery at specific index
    window.openGallery = function(index) {
      // Find and click the corresponding thumbnail in the ImageGallery component
      const modal = document.getElementById('gallery-modal');
      if (modal) {
        // Make it visible temporarily to trigger the click
        modal.style.visibility = 'visible';
        modal.style.position = 'fixed';
        modal.style.top = '0';
        modal.style.left = '0';
        // Find and click the image at the specified index
        setTimeout(() => {
          const images = modal.querySelectorAll('button');
          if (images[index]) {
            images[index].click();
            // Hide the grid again after triggering lightbox
            setTimeout(() => {
              const grid = modal.querySelector('.grid');
              if (grid) {
                grid.style.display = 'none';
              }
            }, 100);
          }
        }, 50);
      }
    };
  </script>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column - Main Content -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Title & Overview -->
        <div>
          <div class="flex flex-wrap gap-2 mb-4">
            {
              group.tags.map((tag) => (
                <span class="px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-sm font-medium capitalize">
                  {tag}
                </span>
              ))
            }
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
            {group.title}
          </h1>

          <div class="flex flex-wrap items-center gap-4 text-slate-600 mb-4">
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
              </svg>
              <span class="font-medium">{group.destination}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{duration} days</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 text-yellow-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                ></path>
              </svg>
              <span>4.9 (127 reviews)</span>
            </div>
          </div>

          <p class="text-lg text-slate-700 leading-relaxed">
            {group.shortDescription}
          </p>
        </div>

        <!-- Quick Info Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div
            class="border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-3"
            >
              <svg
                class="w-6 h-6 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
            </div>
            <div class="text-sm text-slate-600">Group Size</div>
            <div class="text-lg font-bold text-slate-900">{group.maxGroupSize - 4}-{group.maxGroupSize} people</div>
          </div>

          <div
            class="border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
          >
            <div
              class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-3"
            >
              <svg
                class="w-6 h-6 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="text-sm text-slate-600">Age Range</div>
            <div class="text-lg font-bold text-slate-900">{group.ageRangeMin || 18}-{group.ageRangeMax || 65} years</div>
          </div>

          <div
            class="border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
          >
            <div
              class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mb-3"
            >
              <svg
                class="w-6 h-6 text-purple-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div class="text-sm text-slate-600">Activity Level</div>
            <div class="text-lg font-bold text-slate-900">{group.difficulty?.charAt(0).toUpperCase() + group.difficulty?.slice(1) || 'Moderate'}</div>
          </div>
        </div>

        <!-- What's Included -->
        <div class="border border-slate-200 rounded-2xl p-6">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">
            What's Included
          </h2>
          <div class="grid md:grid-cols-2 gap-4">
            {
              (group.includedItems && group.includedItems.length > 0 ? group.includedItems : [
                { title: "Accommodation", description: "Comfortable stays throughout the trip" },
                { title: "Meals", description: "Daily breakfast and select dinners" },
                { title: "Activities", description: "All planned activities and entrance fees" },
                { title: "Transportation", description: "Ground transport and airport transfers" },
                { title: "Guide", description: "Expert local guide throughout" },
                { title: "Insurance", description: "Basic travel insurance coverage" }
              ]).map((item: any) => (
                <div class="flex items-start gap-3">
                  <div
                    class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0 mt-0.5"
                  >
                    <svg
                      class="w-4 h-4 text-green-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-slate-900">{item.title}</div>
                    <div class="text-sm text-slate-600">{item.description}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- What's Not Included -->
        <div class="border border-slate-200 rounded-2xl p-6">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">
            What's Not Included
          </h2>
          <div class="grid md:grid-cols-2 gap-4">
            {
              (group.notIncludedItems && group.notIncludedItems.length > 0 ? group.notIncludedItems : [
                "International flights",
                "Travel insurance",
                "Personal expenses",
                "Optional activities"
              ]).map((item: string) => (
                <div class="flex items-start gap-3">
                  <div
                    class="w-6 h-6 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0 mt-0.5"
                  >
                    <svg
                      class="w-4 h-4 text-red-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-slate-900">{item}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Meet Your Host -->
        <div class="border border-slate-200 rounded-2xl p-6">
          <h2 class="text-2xl font-bold text-slate-900 mb-2">
            Meet Your Host
          </h2>
          <p class="text-slate-600 mb-6">
            {creator ? `Hosted by ${creator.name || creator.email}` : "Hosted by Adventure Leaders"}
          </p>

          <div class="flex items-start gap-6 mb-6">
            <div class="flex-shrink-0">
              {creator ? (
                <a href={`/profile/${creator.id}`}>
                  <div class="w-24 h-24 rounded-full bg-gradient-to-br from-rose-400 to-pink-600 flex items-center justify-center text-white font-bold text-3xl border-4 border-slate-200 hover:scale-105 transition-transform cursor-pointer">
                    {(creator.name || creator.email).slice(0, 2).toUpperCase()}
                  </div>
                </a>
              ) : (
                <img
                  src="https://i.pravatar.cc/150?img=50"
                  alt="Host"
                  class="w-24 h-24 rounded-full border-4 border-slate-200"
                />
              )}
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-xl font-bold text-slate-900">
                  {creator ? (
                    <a 
                      href={`/profile/${creator.id}`}
                      class="text-rose-600 hover:text-rose-700 underline decoration-2 underline-offset-2 transition-colors"
                    >
                      {creator.name || creator.email}
                    </a>
                  ) : (
                    "Adventure Leaders"
                  )}
                </h3>
                <svg
                  class="w-5 h-5 text-blue-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </div>
              <div class="flex items-center gap-4 text-sm text-slate-600 mb-3">
                <span>⭐ 4.9 Host rating</span>
                <span>·</span>
                <span>{isDbListing ? "1" : "15"} {isDbListing ? "property" : "properties"}</span>
              </div>
              <p class="text-slate-700 text-sm leading-relaxed">
                {creator ? "Experienced host providing exceptional stays. Response time: within 1 hour" : "Experienced guides providing unforgettable adventures. Response time: within 1 hour"}
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            {creator && (
              <a 
                href={`/profile/${creator.id}`}
                class="py-3 border border-slate-300 rounded-xl text-center font-semibold hover:bg-slate-50 transition-colors"
              >
                View Profile
              </a>
            )}
            <button class="py-3 border border-slate-300 rounded-xl font-semibold hover:bg-slate-50 transition-colors">
              Contact {creator ? "Host" : "Us"}
            </button>
            {!creator && (
              <button class="py-3 border border-slate-300 rounded-xl font-semibold hover:bg-slate-50 transition-colors">
                View Profile
              </button>
            )}
          </div>
        </div>

        <!-- Itinerary -->
        <div class="border border-slate-200 rounded-2xl p-6">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">
            Day-by-Day Itinerary
          </h2>
          <div class="space-y-6">
            {
              (group.itinerary && group.itinerary.length > 0 ? group.itinerary : 
                Array.from({ length: Math.min(duration, 7) }).map((_, i) => ({
                  day: i + 1,
                  title: i === 0 ? "Arrival & Welcome" : i === Math.min(duration, 7) - 1 ? "Departure Day" : `Day ${i + 1} Adventure`,
                  description: i === 0 
                    ? "Airport pickup and transfer to accommodation. Welcome dinner with the group to meet your fellow travelers and trip leader."
                    : i === Math.min(duration, 7) - 1 
                      ? "Final breakfast together. Airport transfers and fond farewells. Take home memories that will last a lifetime."
                      : `Full day of activities exploring ${group.destination}. Guided tours, local experiences, and free time to explore on your own.`
                }))
              ).map((day: any) => (
                <div class="flex gap-4">
                  <div class="flex-shrink-0">
                    <div class="w-10 h-10 rounded-full bg-rose-500 text-white font-bold flex items-center justify-center">
                      {day.day}
                    </div>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-bold text-slate-900 mb-2">
                      {day.title}
                    </h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                      {day.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Meet Your Group - Dynamic Component -->
        <TravelCompanions
          client:load
          travelers={group.companions || []}
          maxGroupSize={group.maxGroupSize || 12}
          availableSpots={group.seatsLeft || group.availableSpots || 8}
        />

        <!-- Reviews -->
        <div class="border border-slate-200 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-slate-900">Traveler Reviews</h2>
            <div class="flex items-center gap-2">
              <svg
                class="w-6 h-6 text-yellow-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                ></path>
              </svg>
              <span class="text-2xl font-bold text-slate-900">4.9</span>
              <span class="text-slate-600">(127 reviews)</span>
            </div>
          </div>

          <div class="space-y-6">
            {
              Array.from({ length: 3 }).map((_, i) => (
                <div class="border-b border-slate-200 last:border-0 pb-6 last:pb-0">
                  <div class="flex items-start gap-3 mb-3">
                    <img
                      src={`https://i.pravatar.cc/150?img=${i + 20}`}
                      alt="Reviewer"
                      class="w-12 h-12 rounded-full"
                    />
                    <div>
                      <div class="font-semibold text-slate-900">
                        Emily Rodriguez
                      </div>
                      <div class="flex items-center gap-2 text-sm">
                        <div class="flex gap-1">
                          {Array.from({ length: 5 }).map(() => (
                            <svg
                              class="w-4 h-4 text-yellow-500"
                              fill="currentColor"
                              viewBox="0 0 20 20"
                            >
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                          ))}
                        </div>
                        <span class="text-slate-500">• 2 months ago</span>
                      </div>
                    </div>
                  </div>
                  <p class="text-slate-700 leading-relaxed">
                    Amazing experience! The group was fantastic, our guide was
                    knowledgeable and friendly, and the itinerary was perfectly
                    balanced between activities and free time. Would highly
                    recommend!
                  </p>
                </div>
              ))
            }
          </div>

          <button
            class="w-full mt-6 py-3 border border-slate-300 rounded-xl text-slate-700 font-semibold hover:bg-slate-50 transition-colors"
          >
            Read all 127 reviews
          </button>
        </div>

        <!-- FAQs -->
        <div class="border border-slate-200 rounded-2xl p-6">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">
            Frequently Asked Questions
          </h2>
          <div class="space-y-4">
            <details
              class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
            >
              <summary
                class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
              >
                What's the cancellation policy?
                <svg
                  class="w-5 h-5 transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                {group.cancellationPolicy || "Free cancellation up to 30 days before departure. 50% refund for cancellations 15-30 days before. No refund within 15 days of departure. We recommend travel insurance."}
              </p>
            </details>

            <details
              class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
            >
              <summary
                class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
              >
                Can I join as a solo traveler?
                <svg
                  class="w-5 h-5 transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                Absolutely! Over 70% of our travelers join solo. We'll match you
                with a same-gender roommate or you can upgrade to a private room
                for an additional fee.
              </p>
            </details>

            <details
              class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
            >
              <summary
                class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
              >
                What fitness level is required?
                <svg
                  class="w-5 h-5 transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                This trip is rated as moderate activity. You should be
                comfortable walking 3-5 miles per day and participating in
                outdoor activities. No special skills required.
              </p>
            </details>

            <details
              class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
            >
              <summary
                class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
              >
                Do I need travel insurance?
                <svg
                  class="w-5 h-5 transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                While not mandatory, we strongly recommend comprehensive travel
                insurance covering medical emergencies, trip cancellation, and
                lost luggage. We can recommend trusted providers.
              </p>
            </details>
          </div>
        </div>
      </div>

      <!-- Right Column - Booking Card -->
      <div class="lg:col-span-1">
        <div class="sticky top-24">
          <div
            class="border-2 border-slate-200 rounded-2xl p-6 shadow-lg bg-white"
          >
            <!-- Price -->
            <div class="mb-6">
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-4xl font-bold text-slate-900"
                  >RM{group.priceUsd}</span
                >
                <span class="text-slate-600">per person</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-green-600">
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Best price guarantee</span>
              </div>
            </div>

            <!-- Dates -->
            <div class="mb-6 p-4 bg-slate-50 rounded-xl">
              <div class="flex items-center gap-3 mb-3">
                <svg
                  class="w-5 h-5 text-slate-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
                <div>
                  <div class="text-xs text-slate-600">Departure Date</div>
                  <div class="font-semibold text-slate-900">
                    {
                      new Date(group.startDate).toLocaleDateString("en-US", {
                        month: "long",
                        day: "numeric",
                        year: "numeric",
                      })
                    }
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <svg
                  class="w-5 h-5 text-slate-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <div class="text-xs text-slate-600">Duration</div>
                  <div class="font-semibold text-slate-900">
                    {duration} days, {duration - 1} nights
                  </div>
                </div>
              </div>
            </div>

            <!-- Seats Left Alert - Dynamic -->
            <SpotsAlert
              client:load
              listingId={group.id}
              initialAvailableSpots={group.seatsLeft || group.availableSpots || 8}
            />

            <!-- CTA Buttons -->
            <div class="space-y-3">
              <ReserveSpotButton 
                client:load
                listingId={group.id}
                listingTitle={group.title}
                availableSpots={group.availableSpots}
                creatorId={creatorId}
              />
            </div>

            <!-- Trust Signals -->
            <div class="mt-6 pt-6 border-t border-slate-200 space-y-3">
              <div class="flex items-center gap-3 text-sm text-slate-600">
                <svg
                  class="w-5 h-5 text-green-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
                <span>Secure payment processing</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-slate-600">
                <svg
                  class="w-5 h-5 text-green-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
                <span>Free cancellation (30 days)</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-slate-600">
                <svg
                  class="w-5 h-5 text-green-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
                <span>24/7 customer support</span>
              </div>
            </div>

            <!-- Share -->
            <div class="mt-6 pt-6 border-t border-slate-200">
              <div class="flex items-center justify-between">
                <button
                  class="flex items-center gap-2 text-sm text-slate-600 hover:text-rose-600 transition-colors"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                    ></path>
                  </svg>
                  Share trip
                </button>
                <button
                  class="flex items-center gap-2 text-sm text-slate-600 hover:text-rose-600 transition-colors"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    ></path>
                  </svg>
                  Save
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Similar Trips -->
  {
    similarTrips.length > 0 && (
      <div class="bg-slate-50 py-16 px-4">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl font-bold text-slate-900 mb-8">
            Similar Adventures
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {similarTrips.map((trip) => (
              <a href={`/travel/${trip.slug}`} class="group">
                <div class="rounded-2xl overflow-hidden bg-white border border-slate-200 hover:shadow-xl transition-all hover:-translate-y-1">
                  <div class="relative aspect-[4/3] overflow-hidden">
                    <img
                      src={trip.coverUrl}
                      alt={trip.title}
                      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    />
                    {trip.seatsLeft <= 5 && (
                      <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-red-500 text-white text-xs font-semibold">
                        Only {trip.seatsLeft} seats left!
                      </span>
                    )}
                  </div>
                  <div class="p-5">
                    <h3 class="text-xl font-bold text-slate-900 group-hover:text-rose-600 transition-colors mb-2">
                      {trip.title}
                    </h3>
                    <div class="flex items-center gap-2 text-sm text-slate-600 mb-3">
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                      </svg>
                      <span>{trip.destination}</span>
                    </div>
                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                      <div class="text-2xl font-bold text-slate-900">
                        ${trip.priceUsd}
                      </div>
                      <div class="text-sm text-slate-600">
                        {new Date(trip.startDate).toLocaleDateString("en-US", {
                          month: "short",
                          day: "numeric",
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }
</Layout>
