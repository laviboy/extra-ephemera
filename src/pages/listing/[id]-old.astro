        </div>
      </div>
    </section>

    <!-- Map (mock) -->
    <section class="mt-8">
      <h2 class="text-[18px] font-medium">Where you'll be</h2>
      <div
        class="mt-2 h-[320px] w-full rounded-xl border border-slate-200 bg-slate-100 flex items-center justify-center text-slate-500"
      >
        <span>🗺️ Map placeholder</span>
      </div>
    </section>

    <!-- Host card (mock) -->
    <section class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
      <div class="md:col-span-1">
        <div class="rounded-xl border p-4">
          <div class="flex items-center gap-3">
            <div class="h-12 w-12 rounded-full bg-slate-200"></div>
            <div>
              <div class="font-medium">X Place is a Superhost</div>
              <div class="text-xs text-slate-600">
                Responds within an hour · 100% response rate
              </div>
            </div>
          </div>
          <button class="mt-3 w-full rounded-lg border px-4 py-2 text-sm"
            >Message host</button
