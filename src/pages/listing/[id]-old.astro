      </div>
      <!-- Booking card (mock) -->
      <aside class="md:col-span-1">
        <div class="rounded-xl border border-slate-200 p-4 sticky top-6">
          <div class="text-xl font-semibold">
            {listing.priceText.split(" · ")[0]}
