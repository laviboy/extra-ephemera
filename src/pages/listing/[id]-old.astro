        </div>
      </aside>
    </div>

    <!-- Host summary & highlights (mock) -->
    <section class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-3">
        <h2 class="text-[18px] font-medium">About this place</h2>
        <ul class="text-sm text-slate-700 list-disc pl-5 space-y-1">
          <li>Cozy serviced apartment with city view.</li>
          <li>High-speed Wi‑Fi and dedicated workspace.</li>
          <li>Self check-in with smart lock.</li>
        </ul>
      </div>
      <div class="space-y-3">
        <h2 class="text-[18px] font-medium">Hosted by X Place</h2>
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-slate-200"></div>
          <div class="text-sm text-slate-700">
            Superhost · 4 years hosting · 4.9 rating
          </div>
        </div>
        <h3 class="mt-3 font-medium">What this place offers</h3>
        <div class="grid grid-cols-2 gap-2 text-sm text-slate-700">
          <span>Pool</span>
          <span>Gym</span>
          <span>Kitchen</span>
          <span>Free parking</span>
          <span>Air conditioning</span>
          <span>Washer</span>
        </div>
      </div>
    </section>

    <!-- Calendar (mock) -->
    <section class="mt-6 border-t border-slate-200 pt-6">
      <h2 class="text-[18px] font-medium mb-3">{`2 nights in Kuala Lumpur`}</h2>
      <div class="w-full overflow-auto">
        <div class="inline-block border rounded-xl p-3">
          <!-- Weekday headers -->
          <div
            class="grid grid-cols-7 gap-1 text-center text-[11px] text-slate-500"
          >
            {weekdays.map((d) => <div class="py-1">{d}</div>)}
          </div>
          <!-- Days grid (mock) -->
          <div
            class="mt-1 grid grid-cols-7 gap-1 text-center text-xs text-slate-700"
          >
            {Array.from({ length: 3 }).map(() => <div />)}
            {
              daysInMonth.map((d) => (
                <div class="h-8 w-8 flex items-center justify-center rounded hover:bg-slate-100">
                  {d}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Reviews (mock) -->
    <section class="mt-8">
      <div class="text-3xl font-semibold">4.85</div>
      <p class="text-sm text-slate-600">Guest favourite · 200+ reviews</p>
      <!-- Rating breakdown -->
      <div class="mt-4 grid grid-cols-2 md:grid-cols-6 gap-3 text-sm">
        {
          [
            "Cleanliness",
            "Accuracy",
            "Check-in",
            "Communication",
            "Location",
            "Value",
          ].map((k) => (
            <div
              class="flex flex-col items-center gap-1 border rounded-lg p-3"
              title={k}
            >
              <div class="text-[22px]">4.8</div>
              <div class="text-slate-600">{k}</div>
