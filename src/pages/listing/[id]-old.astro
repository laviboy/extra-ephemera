              class="col-span-1 border rounded-lg px-3 py-2 text-sm"
              placeholder="Check-out"
            />
            <input
              class="col-span-2 border rounded-lg px-3 py-2 text-sm"
              placeholder="Guests"
            />
          </div>
          <button class="mt-3 w-full rounded-lg bg-rose-500 text-white py-2"
            >Reserve</button
          >
          <p class="text-center text-[12px] text-slate-500 mt-2">
            You won't be charged yet
