---
import Layout from "../../layouts/Layout.astro";
import { allListings } from "../../data/listings";
import { allGroups } from "../../data/travelGroups";

const { id } = Astro.params;
let listing = allListings.find((l) => l.id === id);

if (!listing) {
  const g = allGroups.find((gr) => gr.slug === id || gr.id === id);
  if (g) {
    listing = {
      id: g.id,
      title: g.title,
      subtitle: `${g.destination} · ${new Date(g.startDate).toLocaleDateString()} – ${new Date(g.endDate).toLocaleDateString()}`,
      priceText: `$${g.priceUsd} per night · 4.8`,
      imageUrl: g.coverUrl,
      isGuestFavorite: false,
    } as any;
  }
}

// If still not found, try fetching from API (for database listings)
if (!listing) {
  try {
    const response = await fetch(`${Astro.url.origin}/api/listings`);
    if (response.ok) {
      const { listings } = await response.json();
      const dbListing = listings.find((l: any) => l.id === id);
      if (dbListing) {
        listing = {
          id: dbListing.id,
          title: dbListing.title,
          subtitle: dbListing.subtitle || dbListing.destination,
          priceText: dbListing.price_min
            ? `RM${dbListing.price_min} per night`
            : "Price TBD",
          imageUrl: `https://picsum.photos/seed/${encodeURIComponent(dbListing.id)}/640/480`,
          isGuestFavorite: false,
        } as any;
      }
    }
  } catch (error) {
    console.error("Error fetching listing:", error);
  }
}

if (!listing) {
  return Astro.redirect("/");
}

// Extract price
const pricePerNight = listing.priceText.split(" ")[0];
const rating = listing.priceText.includes("·") ? listing.priceText.split("·")[1].trim() : "4.85";

// Mock gallery images
const galleryImages = [
  listing.imageUrl,
  `https://picsum.photos/seed/${listing.id}-a/800/600`,
  `https://picsum.photos/seed/${listing.id}-b/800/600`,
  `https://picsum.photos/seed/${listing.id}-c/800/600`,
  `https://picsum.photos/seed/${listing.id}-d/800/600`,
];

// Mock amenities
const amenities = [
  { icon: "🏊", name: "Pool", category: "Standout" },
  { icon: "🏋️", name: "Gym", category: "Standout" },
  { icon: "🅿️", name: "Free parking", category: "Parking" },
  { icon: "🌡️", name: "Air conditioning", category: "Cooling" },
  { icon: "📶", name: "Wifi", category: "Internet" },
  { icon: "👨‍🍳", name: "Kitchen", category: "Kitchen" },
  { icon: "🧺", name: "Washer", category: "Facilities" },
  { icon: "📺", name: "TV", category: "Entertainment" },
  { icon: "🔥", name: "Heating", category: "Heating" },
];

// Get similar listings
const similarListings = allListings.filter(l => l.id !== listing.id).slice(0, 3);
---

<Layout>
  <!-- Breadcrumb -->
  <div class="bg-white border-b sticky top-[73px] z-40">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-rose-600 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to listings
      </a>
    </div>
  </div>

  <!-- Title Section -->
  <div class="max-w-7xl mx-auto px-4 py-6">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="flex-1">
        <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-3">
          {listing.title}
        </h1>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <div class="flex items-center gap-1">
            <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="font-semibold">{rating}</span>
          </div>
          <span class="text-slate-400">·</span>
          <a href="#reviews" class="text-slate-600 hover:text-slate-900 underline">268 reviews</a>
          <span class="text-slate-400">·</span>
          <span class="text-slate-600">{listing.subtitle}</span>
          {listing.isGuestFavorite && (
            <>
              <span class="text-slate-400">·</span>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-semibold">
                🏅 Guest favourite
              </span>
            </>
          )}
        </div>
      </div>
      
      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <button class="flex items-center gap-2 px-4 py-2 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
          </svg>
          <span class="text-sm font-medium hidden md:inline">Share</span>
        </button>
        <button class="flex items-center gap-2 px-4 py-2 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <span class="text-sm font-medium hidden md:inline">Save</span>
        </button>
      </div>
    </div>

    <!-- Photo Gallery -->
    <div class="grid grid-cols-4 gap-2 h-[500px] rounded-2xl overflow-hidden">
      <!-- Main large image -->
      <div class="col-span-4 md:col-span-2 row-span-2 relative group cursor-pointer">
        <img 
          src={galleryImages[0]} 
          alt={listing.title}
          class="w-full h-full object-cover hover:brightness-95 transition-all"
        />
      </div>
      <!-- Side images -->
      {galleryImages.slice(1, 5).map((img, i) => (
        <div class="col-span-2 md:col-span-1 relative group cursor-pointer hidden md:block">
          <img 
            src={img} 
            alt={`${listing.title} ${i + 2}`}
            class="w-full h-full object-cover hover:brightness-95 transition-all"
          />
          {i === 3 && (
            <button class="absolute bottom-4 right-4 px-4 py-2 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors flex items-center gap-2 text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Show all photos
            </button>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column - Property Details -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Host Header -->
        <div class="pb-8 border-b border-slate-200">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold text-slate-900 mb-2">
                Entire apartment hosted by Modern Living
              </h2>
              <div class="flex items-center gap-2 text-slate-600">
                <span>4 guests</span>
                <span>·</span>
                <span>2 bedrooms</span>
                <span>·</span>
                <span>2 beds</span>
                <span>·</span>
                <span>1 bath</span>
              </div>
            </div>
            <div class="hidden md:block">
              <img 
                src="https://i.pravatar.cc/150?img=50" 
                alt="Host"
                class="w-16 h-16 rounded-full border-2 border-slate-200"
              />
            </div>
          </div>
        </div>

        <!-- Continue with rest of content from previous implementation... -->
  <main class="max-w-[1200px] mx-auto px-4 py-6">
    <!-- Title & meta -->
    <h1 class="text-[20px] md:text-[22px] font-medium">{listing.title}</h1>
    <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-slate-600">
      {
        listing.isGuestFavorite && (
          <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[12px] text-slate-800">
            🏅 Guest favourite
          </span>
        )
      }
      <span class="inline-flex items-center gap-1">⭐ 4.85</span>
      <span>· 268 reviews</span>
      <span>·</span>
      <span>{listing.subtitle}</span>
    </div>

    <!-- Gallery + Sidebar -->
    <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-2 grid grid-cols-4 grid-rows-2 gap-2">
