  </div>

    <!-- React Gallery Component - Hidden lightbox that opens on click -->
    <div id="gallery-modal" style="position: fixed; top: -9999px; left: -9999px; visibility: hidden;">
      <ImageGallery 
        images={isDbListing && listingImages.length > 0 
          ? listingImages 
          : galleryImages.map((url, i) => ({ id: `img-${i}`, url, caption: `${listing.title} ${i + 1}` }))
        } 
        client:only="react" 
      />
    </div>
  </div>

  <script is:inline>
    // Global function to open gallery at specific index
    window.openGallery = function(index) {
      // Find and click the corresponding thumbnail in the ImageGallery component
      const modal = document.getElementById('gallery-modal');
      if (modal) {
        // Make it visible temporarily to trigger the click
        modal.style.visibility = 'visible';
        modal.style.position = 'fixed';
        modal.style.top = '0';
        modal.style.left = '0';
        // Find and click the image at the specified index
        setTimeout(() => {
          const images = modal.querySelectorAll('button');
          if (images[index]) {
            images[index].click();
            // Hide the grid again after triggering lightbox
            setTimeout(() => {
              const grid = modal.querySelector('.grid');
              if (grid) {
                grid.style.display = 'none';
              }
            }, 100);
          }
        }, 50);
      }
    };
  </script>

