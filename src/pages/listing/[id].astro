          <p>
            This beautifully designed space features contemporary furnishings,
            high-speed Wi-Fi, and all the amenities you need for a comfortable
            stay. The apartment is located in a prime location with easy access
            to local attractions, restaurants, and transportation.
          </p>
        </div>
        <button
          class="mt-4 font-semibold text-slate-900 underline hover:text-rose-600 transition-colors"
        >
          Show more
        </button>
      </div>

      <!-- Meet Your Host -->
      <div class="border border-slate-200 rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">
          Meet Your Host
        </h2>
        <p class="text-slate-600 mb-6">
          {creator ? `Hosted by ${creator.name || creator.email}` : "Hosted by Modern Living"}
        </p>

        <div class="flex items-start gap-6 mb-6">
          <div class="flex-shrink-0">
            {creator ? (
              <a href={`/profile/${creator.id}`}>
                <div class="w-24 h-24 rounded-full bg-gradient-to-br from-rose-400 to-pink-600 flex items-center justify-center text-white font-bold text-3xl border-4 border-slate-200 hover:scale-105 transition-transform cursor-pointer">
                  {(creator.name || creator.email).slice(0, 2).toUpperCase()}
                </div>
              </a>
            ) : (
              <img
                src="https://i.pravatar.cc/150?img=50"
                alt="Host"
                class="w-24 h-24 rounded-full border-4 border-slate-200"
              />
            )}
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-xl font-bold text-slate-900">
                {creator ? (
                  <a 
                    href={`/profile/${creator.id}`}
                    class="text-rose-600 hover:text-rose-700 underline decoration-2 underline-offset-2 transition-colors"
                  >
                    {creator.name || creator.email}
                  </a>
                ) : (
                  "Modern Living"
                )}
              </h3>
              <svg
                class="w-5 h-5 text-blue-600"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </div>
            <div class="flex items-center gap-4 text-sm text-slate-600 mb-3">
              <span>⭐ 4.9 Host rating</span>
              <span>·</span>
              <span>15 properties</span>
            </div>
            <p class="text-slate-700 text-sm leading-relaxed">
              Experienced host providing exceptional stays. Response time: within 1 hour
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {creator && (
            <a 
              href={`/profile/${creator.id}`}
              class="py-3 border border-slate-300 rounded-xl text-center font-semibold hover:bg-slate-50 transition-colors"
            >
              View Profile
            </a>
          )}
          <button
            class="py-3 border border-slate-300 rounded-xl font-semibold hover:bg-slate-50 transition-colors"
          >
            Contact Host
          </button>
        </div>
      </div>

      <!-- Amenities -->
      <div class="border border-slate-200 rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">
          What this place offers
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {
            amenities.map((amenity) => (
              <div class="flex items-center gap-3 py-3">
                <span class="text-2xl">{amenity.icon}</span>
                <span class="text-slate-900">{amenity.name}</span>
              </div>
            ))
          }
        </div>
        <button
          class="mt-6 w-full py-3 border border-slate-300 rounded-xl text-slate-700 font-semibold hover:bg-slate-50 transition-colors"
        >
          Show all amenities
        </button>
      </div>

      <!-- Reviews -->
      <div class="border border-slate-200 rounded-2xl p-6" id="reviews">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-slate-900">Guest Reviews</h2>
          <div class="flex items-center gap-2">
            <svg
              class="w-6 h-6 text-yellow-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <span class="text-2xl font-bold text-slate-900">{rating}</span>
            <span class="text-slate-600">(268 reviews)</span>
          </div>
        </div>

        <div class="space-y-6">
          {
            Array.from({ length: 3 }).map((_, i) => (
              <div class="border-b border-slate-200 last:border-0 pb-6 last:pb-0">
                <div class="flex items-start gap-3 mb-3">
                  <img
                    src={`https://i.pravatar.cc/150?img=${i + 20}`}
                    alt="Reviewer"
                    class="w-12 h-12 rounded-full"
                  />
                  <div>
                    <div class="font-semibold text-slate-900">
                      {i === 0 ? "Sarah Johnson" : i === 1 ? "Michael Chen" : "Emma Wilson"}
                    </div>
                    <div class="flex items-center gap-2 text-sm">
                      <div class="flex gap-1">
                        {Array.from({ length: 5 }).map(() => (
                          <svg
                            class="w-4 h-4 text-yellow-500"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                          >
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                        ))}
                      </div>
                      <span class="text-slate-500">· {i === 0 ? "1 week ago" : i === 1 ? "2 weeks ago" : "1 month ago"}</span>
                    </div>
                  </div>
                </div>
                <p class="text-slate-700 leading-relaxed">
                  {i === 0 
                    ? "Amazing place! Everything was exactly as described. The location is perfect, close to everything. Host was very responsive and helpful. Would definitely stay here again!"
                    : i === 1 
                    ? "Great apartment with modern amenities. Very clean and comfortable. The self check-in was super convenient. Highly recommend for anyone visiting the area."
                    : "Wonderful stay! The place exceeded our expectations. Beautiful decor, spotless, and in a fantastic location. The host provided excellent recommendations for local restaurants."}
                </p>
              </div>
            ))
          }
        </div>

        <button
          class="w-full mt-6 py-3 border border-slate-300 rounded-xl text-slate-700 font-semibold hover:bg-slate-50 transition-colors"
        >
          Read all 268 reviews
        </button>
      </div>

      <!-- FAQs -->
      <div class="border border-slate-200 rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details
            class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
          >
            <summary
              class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
            >
              What's the check-in process?
              <svg
                class="w-5 h-5 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">
              Check-in is self-service using our smart lock system. You'll receive detailed instructions with the access code 24 hours before your arrival. Check-in time is from 3:00 PM.
            </p>
          </details>

          <details
            class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
          >
            <summary
              class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
            >
              Is parking available?
              <svg
                class="w-5 h-5 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">
              Yes, free parking is available on-site. There's a dedicated parking spot for guests, and street parking is also available nearby if needed.
            </p>
          </details>

          <details
            class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
          >
            <summary
              class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
            >
              What's the cancellation policy?
              <svg
                class="w-5 h-5 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">
              Free cancellation up to 48 hours before check-in. For cancellations within 48 hours, a 50% refund applies. No-shows are non-refundable.
            </p>
          </details>

          <details
            class="group border border-slate-200 rounded-xl p-4 hover:border-rose-300 transition-colors"
          >
            <summary
              class="font-semibold text-slate-900 cursor-pointer flex items-center justify-between"
            >
              Are pets allowed?
              <svg
                class="w-5 h-5 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">
              Unfortunately, pets are not allowed in this property to maintain a clean and allergen-free environment for all guests.
            </p>
          </details>
        </div>
      </div>
    </div>

    <!-- Right Column - Booking Card -->
    <div class="lg:col-span-1">
      <div class="sticky top-24">
        <div
          class="border-2 border-slate-200 rounded-2xl shadow-xl p-6 bg-white"
        >
          <!-- Price -->
          <div class="mb-6">
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-bold text-slate-900"
                >{pricePerNight}</span
              >
              <span class="text-slate-600">night</span>
            </div>
            <div class="flex items-center gap-2 text-sm mt-1">
              <svg
                class="w-4 h-4 text-yellow-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                ></path>
              </svg>
              <span class="font-semibold">{rating}</span>
              <span class="text-slate-400">·</span>
              <a
                href="#reviews"
                class="text-slate-600 underline hover:text-slate-900"
                >268 reviews</a
              >
            </div>
          </div>

          <!-- Booking Form -->
          <div
            class="mb-4 border-2 border-slate-300 rounded-xl overflow-hidden"
          >
            <div class="grid grid-cols-2">
              <div class="p-3 border-r border-b border-slate-300">
                <label class="block text-xs font-bold text-slate-900 mb-1"
                  >CHECK-IN</label
                >
                <input
                  type="text"
                  placeholder="Add date"
                  class="w-full text-sm outline-none"
                />
              </div>
              <div class="p-3 border-b border-slate-300">
                <label class="block text-xs font-bold text-slate-900 mb-1"
                  >CHECKOUT</label
                >
                <input
                  type="text"
                  placeholder="Add date"
                  class="w-full text-sm outline-none"
                />
              </div>
            </div>
            <div class="p-3">
              <label class="block text-xs font-bold text-slate-900 mb-1"
                >GUESTS</label
              >
              <input
                type="text"
                placeholder="1 guest"
                class="w-full text-sm outline-none"
              />
            </div>
          </div>

          <!-- Reserve Button -->
          <button
            class="w-full py-3 bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 text-white font-bold rounded-xl transition-all shadow-lg hover:shadow-xl mb-4"
          >
            Reserve
          </button>

          <p class="text-center text-sm text-slate-600 mb-6">
            You won't be charged yet
          </p>

          <!-- Price Breakdown -->
          <div class="space-y-3 pb-6 border-b border-slate-200">
            <div class="flex justify-between text-sm">
              <span class="text-slate-600 underline"
                >{pricePerNight} × 5 nights</span
              >
              <span class="text-slate-900">RM1,250</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-slate-600 underline">Cleaning fee</span>
              <span class="text-slate-900">RM50</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-slate-600 underline">Service fee</span>
              <span class="text-slate-900">RM180</span>
            </div>
          </div>

          <!-- Total -->
          <div class="flex justify-between items-center pt-6">
            <span class="font-bold text-slate-900">Total</span>
            <span class="text-xl font-bold text-slate-900">RM1,480</span>
          </div>
        </div>

        <!-- Report Listing -->
        <div class="mt-6 text-center">
          <button
            class="text-sm text-slate-600 hover:text-slate-900 underline flex items-center justify-center gap-2 mx-auto"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"
              ></path>
            </svg>
            Report this listing
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Similar Listings -->
{
  similarListings.length > 0 && (
    <div class="bg-slate-50 py-16 px-4 mt-8 border-t border-slate-200">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-8">
          Similar listings you might like
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {similarListings.map((similar) => (
            <a href={`/travel/${similar.id}`} class="group">
              <div class="rounded-2xl overflow-hidden bg-white hover:shadow-xl transition-all hover:-translate-y-1">
                <div class="relative aspect-square overflow-hidden">
                  <img
                    src={similar.imageUrl}
                    alt={similar.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  />
                  {similar.isGuestFavorite && (
                    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm rounded-full p-2">
                      <svg
                        class="w-5 h-5 text-rose-500"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="font-semibold text-slate-900 mb-1 group-hover:text-rose-600 transition-colors">
                    {similar.title}
                  </h3>
                  <p class="text-sm text-slate-600 mb-2">{similar.subtitle}</p>
                  <div class="flex items-center justify-between">
                    <span class="font-semibold text-slate-900">
                      {similar.priceText.split("·")[0]}
                    </span>
                    {similar.priceText.includes("·") && (
                      <span class="text-sm text-slate-600">
                        ★ {similar.priceText.split("·")[1].trim()}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )
}
