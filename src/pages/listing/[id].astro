---
import Layout from "../../layouts/Layout.astro";
import { allListings } from "../../data/listings";
import { allGroups } from "../../data/travelGroups";
import { ImageGallery } from "../../components/ui/image-gallery";

const { id } = Astro.params;
let listing = allListings.find((l) => l.id === id);
let isDbListing = false;
let listingImages: Array<{ id: string; url: string; caption?: string }> = [];
let creator: { id: string; name: string | null; email: string; role: string } | null = null;

if (!listing) {
  const g = allGroups.find((gr) => gr.slug === id || gr.id === id);
  if (g) {
    listing = {
      id: g.id,
      title: g.title,
      subtitle: `${g.destination} · ${new Date(g.startDate).toLocaleDateString()} – ${new Date(g.endDate).toLocaleDateString()}`,
      priceText: `$${g.priceUsd} per night · 4.8`,
      imageUrl: g.coverUrl,
      isGuestFavorite: false,
    } as any;
  }
}

// If still not found, try fetching from API (for database listings)
if (!listing) {
  try {
    const response = await fetch(`${Astro.url.origin}/api/listings`);
    if (response.ok) {
      const { listings } = await response.json();
      const dbListing = listings.find((l: any) => l.id === id);
      if (dbListing) {
        isDbListing = true;
        creator = dbListing.creator || null;
        listing = {
          id: dbListing.id,
          title: dbListing.title,
          subtitle: dbListing.subtitle || dbListing.destination,
          priceText: dbListing.price_min
            ? `RM${dbListing.price_min} per night`
            : "Price TBD",
          imageUrl:
            dbListing.first_image_url ||
            `https://picsum.photos/seed/${encodeURIComponent(dbListing.id)}/640/480`,
          isGuestFavorite: false,
        } as any;

        // Fetch images for this listing
        try {
          const imagesResponse = await fetch(
            `${Astro.url.origin}/api/images?listingId=${id}`
          );
          if (imagesResponse.ok) {
            const { images } = await imagesResponse.json();
            listingImages = images || [];
          }
        } catch (imgError) {
          console.error("Error fetching images:", imgError);
        }
      }
    }
  } catch (error) {
    console.error("Error fetching listing:", error);
  }
}

if (!listing) {
  return Astro.redirect("/404");
}

// Populate galleryImages with real images only
const galleryImages =
  isDbListing && listingImages.length > 0
    ? listingImages.map((img) => img.url)
    : [listing.imageUrl];

console.log('Gallery Images:', galleryImages);
console.log('Gallery Images Length:', galleryImages.length);

const rating = listing.priceText.includes("·")
  ? listing.priceText.split("·")[1].trim()
  : "4.85";

// Extract price per night from priceText (e.g., "RM270 per night" → "RM270")
const pricePerNight = listing.priceText.split(" per night")[0].trim();

// Mock amenities
const amenities = [
  { icon: "🏊", name: "Pool", category: "Standout" },
  { icon: "🏋️", name: "Gym", category: "Standout" },
  { icon: "🅿️", name: "Free parking", category: "Parking" },
  { icon: "🌡️", name: "Air conditioning", category: "Cooling" },
  { icon: "📶", name: "Wifi", category: "Internet" },
  { icon: "👨‍🍳", name: "Kitchen", category: "Kitchen" },
  { icon: "🧺", name: "Washer", category: "Facilities" },
  { icon: "📺", name: "TV", category: "Entertainment" },
  { icon: "🔥", name: "Heating", category: "Heating" },
];

// Get similar listings
const similarListings = allListings
  .filter((l) => l.id !== listing.id)
  .slice(0, 3);
---

<Layout>
  <!-- Breadcrumb -->
  <div class="bg-white border-b sticky top-[73px] z-40">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-rose-600 transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to listings
      </a>
    </div>
  </div>

  <!-- Title Section -->
  <div class="max-w-7xl mx-auto px-4 py-6">
    <div class="flex items-start justify-between gap-4 mb-4 flex-wrap">
      <div class="flex-1">
        <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-3">
          {listing.title}
        </h1>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <div class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-yellow-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <span class="font-semibold">{rating}</span>
          </div>
          <span class="text-slate-400">·</span>
          <a
            href="#reviews"
            class="text-slate-600 hover:text-slate-900 underline">268 reviews</a
          >
          <span class="text-slate-400">·</span>
          <span class="text-slate-600">{listing.subtitle}</span>
          {listing.isGuestFavorite && <span class="text-slate-400">·</span>}
          {
            listing.isGuestFavorite && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-semibold">
                🏅 Guest favourite
              </span>
            )
          }
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <button
          class="flex items-center gap-2 px-4 py-2 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
            ></path>
          </svg>
          <span class="text-sm font-medium hidden md:inline">Share</span>
        </button>
        <button
          class="flex items-center gap-2 px-4 py-2 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            ></path>
          </svg>
          <span class="text-sm font-medium hidden md:inline">Save</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Image Gallery -->
  <div class="max-w-7xl mx-auto px-4">
    <div id="gallery-grid" class="rounded-2xl overflow-hidden border-2 border-slate-200">
      {galleryImages.length === 1 && (
        <!-- 1 image: Single main -->
        <div class="h-[400px] md:h-[500px] cursor-pointer" onclick="window.openGallery(0)">
          <img
            src={galleryImages[0]}
            alt={listing.title}
            class="w-full h-full object-cover hover:brightness-95 transition-all"
          />
        </div>
      )}

      {galleryImages.length === 2 && (
        <!-- 2 images: Main + 1 side -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 h-auto md:h-[500px]">
          <div class="h-[300px] md:h-full cursor-pointer" onclick="window.openGallery(0)">
            <img
              src={galleryImages[0]}
              alt={listing.title}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[300px] md:h-full cursor-pointer" onclick="window.openGallery(1)">
            <img
              src={galleryImages[1]}
              alt={`${listing.title} 2`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
        </div>
      )}

      {galleryImages.length === 3 && (
        <!-- 3 images: Main + 2 on right (top/bottom) -->
        <div class="grid grid-cols-1 md:grid-cols-2 md:grid-rows-2 gap-2 h-auto md:h-[500px]">
          <div class="h-[300px] md:h-full md:row-span-2 cursor-pointer" onclick="window.openGallery(0)">
            <img
              src={galleryImages[0]}
              alt={listing.title}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full cursor-pointer" onclick="window.openGallery(1)">
            <img
              src={galleryImages[1]}
              alt={`${listing.title} 2`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full cursor-pointer" onclick="window.openGallery(2)">
            <img
              src={galleryImages[2]}
              alt={`${listing.title} 3`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
        </div>
      )}

      {galleryImages.length === 4 && (
        <!-- 4 images: Main + 1 top + 2 bottom -->
        <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-2 h-auto md:h-[500px]">
          <div class="h-[300px] md:h-full md:col-span-2 md:row-span-2 cursor-pointer" onclick="window.openGallery(0)">
            <img
              src={galleryImages[0]}
              alt={listing.title}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full md:col-span-2 cursor-pointer" onclick="window.openGallery(1)">
            <img
              src={galleryImages[1]}
              alt={`${listing.title} 2`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full cursor-pointer" onclick="window.openGallery(2)">
            <img
              src={galleryImages[2]}
              alt={`${listing.title} 3`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full cursor-pointer" onclick="window.openGallery(3)">
            <img
              src={galleryImages[3]}
              alt={`${listing.title} 4`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
        </div>
      )}

      {galleryImages.length >= 5 && (
        <!-- 5+ images: Main + 2 top + 2 bottom, with show more on last -->
        <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-2 h-auto md:h-[500px]">
          <div class="h-[300px] md:h-full md:col-span-2 md:row-span-2 cursor-pointer" onclick="window.openGallery(0)">
            <img
              src={galleryImages[0]}
              alt={listing.title}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full cursor-pointer" onclick="window.openGallery(1)">
            <img
              src={galleryImages[1]}
              alt={`${listing.title} 2`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full cursor-pointer" onclick="window.openGallery(2)">
            <img
              src={galleryImages[2]}
              alt={`${listing.title} 3`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full cursor-pointer" onclick="window.openGallery(3)">
            <img
              src={galleryImages[3]}
              alt={`${listing.title} 4`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
          </div>
          <div class="h-[250px] md:h-full relative cursor-pointer" onclick="window.openGallery(4)">
            <img
              src={galleryImages[4]}
              alt={`${listing.title} 5`}
              class="w-full h-full object-cover hover:brightness-95 transition-all"
            />
            {galleryImages.length > 5 && (
              <div class="absolute inset-0 bg-black/60 flex items-center justify-center hover:bg-black/70 transition-all">
                <span class="text-white text-xl font-semibold">
                  +{galleryImages.length - 5} more
                </span>
              </div>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- React Gallery Component - Hidden lightbox that opens on click -->
    <div id="gallery-modal" style="position: fixed; top: -9999px; left: -9999px; visibility: hidden;">
      <ImageGallery 
        images={isDbListing && listingImages.length > 0 
          ? listingImages 
          : galleryImages.map((url, i) => ({ id: `img-${i}`, url, caption: `${listing.title} ${i + 1}` }))
        } 
        client:only="react" 
      />
    </div>
  </div>

  <script is:inline>
    // Global function to open gallery at specific index
    window.openGallery = function(index) {
      // Find and click the corresponding thumbnail in the ImageGallery component
      const modal = document.getElementById('gallery-modal');
      if (modal) {
        // Make it visible temporarily to trigger the click
        modal.style.visibility = 'visible';
        modal.style.position = 'fixed';
        modal.style.top = '0';
        modal.style.left = '0';
        // Find and click the image at the specified index
        setTimeout(() => {
          const images = modal.querySelectorAll('button');
          if (images[index]) {
            images[index].click();
            // Hide the grid again after triggering lightbox
            setTimeout(() => {
              const grid = modal.querySelector('.grid');
              if (grid) {
                grid.style.display = 'none';
              }
            }, 100);
          }
        }, 50);
      }
    };
  </script>

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column - Property Details -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Host Header -->
      <div class="pb-8 border-b border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-2">
              {creator ? (
                <>
                  Entire apartment hosted by{" "}
                  <a 
                    href={`/profile/${creator.id}`}
                    class="text-rose-600 hover:text-rose-700 underline decoration-2 underline-offset-2 transition-colors"
                  >
                    {creator.name || creator.email}
                  </a>
                </>
              ) : (
                "Entire apartment hosted by Modern Living"
              )}
            </h2>
            <div class="flex items-center gap-2 text-slate-600">
              <span>4 guests</span>
              <span>·</span>
              <span>2 bedrooms</span>
              <span>·</span>
              <span>2 beds</span>
              <span>·</span>
              <span>1 bath</span>
            </div>
          </div>
          <div class="hidden md:block">
            {creator ? (
              <a href={`/profile/${creator.id}`}>
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-rose-400 to-pink-600 flex items-center justify-center text-white font-bold text-xl border-2 border-slate-200 hover:scale-105 transition-transform cursor-pointer">
                  {(creator.name || creator.email).slice(0, 2).toUpperCase()}
                </div>
              </a>
            ) : (
              <img
                src="https://i.pravatar.cc/150?img=50"
                alt="Host"
                class="w-16 h-16 rounded-full border-2 border-slate-200"
              />
            )}
          </div>
        </div>
      </div>

      <!-- Key Features -->
      <div class="pb-8 border-b border-slate-200 space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 flex-shrink-0">
            <svg
              class="w-full h-full text-slate-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">Entire place</h3>
            <p class="text-slate-600 text-sm">
              You'll have the apartment to yourself.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 flex-shrink-0">
            <svg
              class="w-full h-full text-slate-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">Enhanced Clean</h3>
            <p class="text-slate-600 text-sm">
              This host committed to enhanced cleaning process.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 flex-shrink-0">
            <svg
              class="w-full h-full text-slate-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">Self check-in</h3>
            <p class="text-slate-600 text-sm">
              Check yourself in with the smart lock.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 flex-shrink-0">
            <svg
              class="w-full h-full text-slate-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">
              Free cancellation before 48 hours
            </h3>
            <p class="text-slate-600 text-sm">
              Get a full refund if you change your plans.
            </p>
          </div>
        </div>
      </div>

      <!-- About This Place -->
      <div class="pb-8 border-b border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">About this place</h2>
        <div class="text-slate-700 leading-relaxed space-y-4">
          <p>
            Welcome to our modern and stylish apartment in the heart of {
              listing.subtitle.split("·")[0]
            }! Perfect for travelers looking for comfort and convenience during
            their stay.
          </p>
          <p>
            This beautifully designed space features contemporary furnishings,
            high-speed Wi-Fi, and all the amenities you need for a comfortable
            stay. The apartment is located in a prime location with easy access
            to local attractions, restaurants, and transportation.
          </p>
        </div>
        <button
          class="mt-4 font-semibold text-slate-900 underline hover:text-rose-600 transition-colors"
        >
          Show more
        </button>
      </div>

      <!-- What This Place Offers -->
      <div class="pb-8 border-b border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">
          What this place offers
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {
            amenities.map((amenity) => (
              <div class="flex items-center gap-3 py-3">
                <span class="text-2xl">{amenity.icon}</span>
                <span class="text-slate-900">{amenity.name}</span>
              </div>
            ))
          }
        </div>
        <button
          class="mt-6 w-full md:w-auto px-6 py-3 border-2 border-slate-900 rounded-xl font-semibold hover:bg-slate-50 transition-colors"
        >
          Show all amenities
        </button>
      </div>
    </div>

    <!-- Right Column - Booking Card -->
    <div class="lg:col-span-1">
      <div class="sticky top-24">
        <div
          class="border-2 border-slate-200 rounded-2xl shadow-xl p-6 bg-white"
        >
          <!-- Price -->
          <div class="mb-6">
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-bold text-slate-900"
                >{pricePerNight}</span
              >
              <span class="text-slate-600">night</span>
            </div>
            <div class="flex items-center gap-2 text-sm mt-1">
              <svg
                class="w-4 h-4 text-yellow-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                ></path>
              </svg>
              <span class="font-semibold">{rating}</span>
              <span class="text-slate-400">·</span>
              <a
                href="#reviews"
                class="text-slate-600 underline hover:text-slate-900"
                >268 reviews</a
              >
            </div>
          </div>

          <!-- Booking Form -->
          <div
            class="mb-4 border-2 border-slate-300 rounded-xl overflow-hidden"
          >
            <div class="grid grid-cols-2">
              <div class="p-3 border-r border-b border-slate-300">
                <label class="block text-xs font-bold text-slate-900 mb-1"
                  >CHECK-IN</label
                >
                <input
                  type="text"
                  placeholder="Add date"
                  class="w-full text-sm outline-none"
                />
              </div>
              <div class="p-3 border-b border-slate-300">
                <label class="block text-xs font-bold text-slate-900 mb-1"
                  >CHECKOUT</label
                >
                <input
                  type="text"
                  placeholder="Add date"
                  class="w-full text-sm outline-none"
                />
              </div>
            </div>
            <div class="p-3">
              <label class="block text-xs font-bold text-slate-900 mb-1"
                >GUESTS</label
              >
              <input
                type="text"
                placeholder="1 guest"
                class="w-full text-sm outline-none"
              />
            </div>
          </div>

          <!-- Reserve Button -->
          <button
            class="w-full py-3 bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 text-white font-bold rounded-xl transition-all shadow-lg hover:shadow-xl mb-4"
          >
            Reserve
          </button>

          <p class="text-center text-sm text-slate-600 mb-6">
            You won't be charged yet
          </p>

          <!-- Price Breakdown -->
          <div class="space-y-3 pb-6 border-b border-slate-200">
            <div class="flex justify-between text-sm">
              <span class="text-slate-600 underline"
                >{pricePerNight} × 5 nights</span
              >
              <span class="text-slate-900">RM1,250</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-slate-600 underline">Cleaning fee</span>
              <span class="text-slate-900">RM50</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-slate-600 underline">Service fee</span>
              <span class="text-slate-900">RM180</span>
            </div>
          </div>

          <!-- Total -->
          <div class="flex justify-between items-center pt-6">
            <span class="font-bold text-slate-900">Total</span>
            <span class="text-xl font-bold text-slate-900">RM1,480</span>
          </div>
        </div>

        <!-- Report Listing -->
        <div class="mt-6 text-center">
          <button
            class="text-sm text-slate-600 hover:text-slate-900 underline flex items-center justify-center gap-2 mx-auto"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"
              ></path>
            </svg>
            Report this listing
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Similar Listings -->
{
  similarListings.length > 0 && (
    <div class="bg-slate-50 py-16 px-4 mt-8 border-t border-slate-200">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-8">
          Similar listings you might like
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {similarListings.map((similar) => (
            <a href={`/listing/${similar.id}`} class="group">
              <div class="rounded-2xl overflow-hidden bg-white hover:shadow-xl transition-all hover:-translate-y-1">
                <div class="relative aspect-square overflow-hidden">
                  <img
                    src={similar.imageUrl}
                    alt={similar.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  />
                  {similar.isGuestFavorite && (
                    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm rounded-full p-2">
                      <svg
                        class="w-5 h-5 text-rose-500"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="font-semibold text-slate-900 mb-1 group-hover:text-rose-600 transition-colors">
                    {similar.title}
                  </h3>
                  <p class="text-sm text-slate-600 mb-2">{similar.subtitle}</p>
                  <div class="flex items-center justify-between">
                    <span class="font-semibold text-slate-900">
                      {similar.priceText.split("·")[0]}
                    </span>
                    {similar.priceText.includes("·") && (
                      <span class="text-sm text-slate-600">
                        ★ {similar.priceText.split("·")[1].trim()}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )
}
