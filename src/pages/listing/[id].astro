---
import Layout from "../../layouts/Layout.astro";
import { allListings } from "../../data/listings";
import { allGroups } from "../../data/travelGroups";
import { ImageGallery } from "../../components/ui/image-gallery";

const { id } = Astro.params;
let listing = allListings.find((l) => l.id === id);
let isDbListing = false;
let listingImages: Array<{ id: string; url: string; caption?: string }> = [];
let creator: { id: string; name: string | null; email: string; role: string } | null = null;

if (!listing) {
  const g = allGroups.find((gr) => gr.slug === id || gr.id === id);
  if (g) {
    listing = {
      id: g.id,
      title: g.title,
      subtitle: `${g.destination} · ${new Date(g.startDate).toLocaleDateString()} – ${new Date(g.endDate).toLocaleDateString()}`,
      priceText: `$${g.priceUsd} per night · 4.8`,
      imageUrl: g.coverUrl,
      isGuestFavorite: false,
    } as any;
  }
}

// If still not found, try fetching from API (for database listings)
if (!listing) {
  try {
    const response = await fetch(`${Astro.url.origin}/api/listings`);
    if (response.ok) {
      const { listings } = await response.json();
      const dbListing = listings.find((l: any) => l.id === id);
      if (dbListing) {
        isDbListing = true;
        creator = dbListing.creator || null;
        listing = {
          id: dbListing.id,
          title: dbListing.title,
          subtitle: dbListing.subtitle || dbListing.destination,
          priceText: dbListing.price_min
            ? `RM${dbListing.price_min} per night`
            : "Price TBD",
          imageUrl:
            dbListing.first_image_url ||
            `https://picsum.photos/seed/${encodeURIComponent(dbListing.id)}/640/480`,
          isGuestFavorite: false,
        } as any;

        // Fetch images for this listing
        try {
          const imagesResponse = await fetch(
            `${Astro.url.origin}/api/images?listingId=${id}`
          );
          if (imagesResponse.ok) {
            const { images } = await imagesResponse.json();
            listingImages = images || [];
          }
        } catch (imgError) {
          console.error("Error fetching images:", imgError);
        }
      }
    }
  } catch (error) {
    console.error("Error fetching listing:", error);
  }
}

if (!listing) {
  return Astro.redirect("/404");
}

// Populate galleryImages with real images only
const galleryImages =
  isDbListing && listingImages.length > 0
    ? listingImages.map((img) => img.url)
    : [listing.imageUrl];

console.log('Gallery Images:', galleryImages);
console.log('Gallery Images Length:', galleryImages.length);

const rating = listing.priceText.includes("·")
  ? listing.priceText.split("·")[1].trim()
  : "4.85";

// Extract price per night from priceText (e.g., "RM270 per night" → "RM270")
const pricePerNight = listing.priceText.split(" per night")[0].trim();

// Mock amenities
const amenities = [
  { icon: "🏊", name: "Pool", category: "Standout" },
  { icon: "🏋️", name: "Gym", category: "Standout" },
  { icon: "🅿️", name: "Free parking", category: "Parking" },
  { icon: "🌡️", name: "Air conditioning", category: "Cooling" },
  { icon: "📶", name: "Wifi", category: "Internet" },
  { icon: "👨‍🍳", name: "Kitchen", category: "Kitchen" },
  { icon: "🧺", name: "Washer", category: "Facilities" },
  { icon: "📺", name: "TV", category: "Entertainment" },
  { icon: "🔥", name: "Heating", category: "Heating" },
];

// Get similar listings
const similarListings = allListings
  .filter((l) => l.id !== listing.id)
  .slice(0, 3);
