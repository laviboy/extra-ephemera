<section class="px-4 py-12 text-center">
	<div class="max-w-[1000px] mx-auto">
		<h3 class="text-[18px] font-medium">Our locations for you</h3>
		<p class="text-slate-600 text-sm mt-1">Popular regions where our travel groups meet.</p>
		<div class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
			{['Bali','Kyoto','Reykjavík','Porto','Marrakesh','Chiang Mai'].map((c) => (
				<div class="rounded-full border px-4 py-2 text-sm text-slate-700">{c}</div>
			))}
		</div>
	</div>
</section>


