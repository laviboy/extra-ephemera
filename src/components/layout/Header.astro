---
import AuthButton from "../auth/AuthButton.tsx";

const isHomePage = Astro.url.pathname === "/";
---

<header class="w-full border-b bg-white">
  <div
    class="max-w-[1200px] mx-auto px-4 py-4 flex items-center justify-between"
  >
    <!-- Logo at the front -->
    <a href="/" class="flex items-center gap-2">
      <div class="text-rose-500 font-black text-xl">◯</div>
      <span class="font-semibold">wandra</span>
    </a>

    <!-- Actions at the back -->
    <div class="flex items-center gap-3">
      <!-- Create listing button - only show when logged in -->
      <a
        href="/listing/create"
        id="create-listing-btn"
        class="hidden text-sm rounded-full border px-4 py-2 hover:bg-slate-50 transition-colors"
        >Create listing</a
      >

      <!-- Auth button -->
      <AuthButton client:load />
    </div>
  </div>
</header>

<script>
  import { useAuth } from "../../stores/useAuth";

  // Show create listing button only when user is logged in
  function updateCreateListingButton() {
    const createListingBtn = document.getElementById("create-listing-btn");
    const user = useAuth.getState().user;

    if (createListingBtn) {
      if (user) {
        createListingBtn.classList.remove("hidden");
        createListingBtn.classList.add("md:inline-block");
      } else {
        createListingBtn.classList.add("hidden");
        createListingBtn.classList.remove("md:inline-block");
      }
    }
  }

  // Run on page load
  updateCreateListingButton();

  // Subscribe to auth state changes
  const unsubscribe = useAuth.subscribe((state) => {
    updateCreateListingButton();
  });

  // Cleanup on navigation
  document.addEventListener("astro:before-swap", () => {
    unsubscribe();
  });
</script>
<!-- Search bar - only show on homepage -->
{
  isHomePage && (
    <div class="px-4 pb-4">
      <div class="max-w-[1200px] mx-auto">
        <div class="mx-auto rounded-full bg-white shadow-[0_10px_25px_-10px_rgba(0,0,0,0.25)] border border-slate-200 overflow-hidden flex items-stretch max-w-[840px]">
          <div class="flex-1 px-5 py-3">
            <div class="text-[12px] text-slate-700">Where</div>
            <div class="text-[13px] text-slate-400">Search destinations</div>
          </div>
          <div class="w-px bg-slate-200 my-2" />
          <div class="flex-1 px-5 py-3 hidden sm:block">
            <div class="text-[12px] text-slate-700">When</div>
            <div class="text-[13px] text-slate-400">Add dates</div>
          </div>
          <div class="w-px bg-slate-200 my-2 hidden sm:block" />
          <div class="flex-1 px-5 py-3">
            <div class="text-[12px] text-slate-700">Who</div>
            <div class="text-[13px] text-slate-400">Add guests</div>
          </div>
          <button class="m-1 mr-2 my-2 h-10 w-10 rounded-full bg-rose-500 text-white flex items-center justify-center">
            🔍
          </button>
        </div>
      </div>
    </div>
  )
}
